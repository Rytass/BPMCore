# Loaded by nx for every `test` target (local and CI alike).
# Nest 12 ships as ESM. Jest 30 loads ESM through require() only when
# `vm.SourceTextModule` exists, which Node exposes only under this flag;
# without it every suite importing @nestjs/* fails with "Must use import".
# nx never overrides a variable the shell already has: if NODE_OPTIONS is set
# there, this line is ignored, so append the flag to it yourself (CI does).
NODE_OPTIONS=--experimental-vm-modules
