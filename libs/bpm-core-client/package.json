{
  "name": "@rytass/bpm-core-client",
  "version": "0.13.3",
  "description": "Framework-agnostic TypeScript client for the Rytass BPM approval workflow GraphQL surface: fetch-based GraphQL transport, REST auth client, pre-baked typed operations for organization, member, form, template, and workflow.",
  "keywords": [
    "bpm",
    "approval",
    "workflow",
    "graphql",
    "client",
    "fetch",
    "nextjs",
    "react",
    "rytass"
  ],
  "homepage": "https://github.com/Rytass/BPMCore#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rytass/BPMCore.git",
    "directory": "libs/bpm-core-client"
  },
  "bugs": {
    "url": "https://github.com/Rytass/BPMCore/issues"
  },
  "author": "Rytass <hello@rytass.com>",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "typesVersions": {
    "*": {
      "form": [
        "./src/lib/form/index.d.ts"
      ],
      "organization": [
        "./src/lib/organization/index.d.ts"
      ],
      "template": [
        "./src/lib/template/index.d.ts"
      ],
      "workflow": [
        "./src/lib/workflow/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json",
    "./organization": {
      "types": "./src/lib/organization/index.d.ts",
      "default": "./src/lib/organization/index.js"
    },
    "./form": {
      "types": "./src/lib/form/index.d.ts",
      "default": "./src/lib/form/index.js"
    },
    "./template": {
      "types": "./src/lib/template/index.d.ts",
      "default": "./src/lib/template/index.js"
    },
    "./workflow": {
      "types": "./src/lib/workflow/index.d.ts",
      "default": "./src/lib/workflow/index.js"
    }
  },
  "peerDependencies": {
    "@rytass/bpm-core-shared": "^0.13.3"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  }
}
