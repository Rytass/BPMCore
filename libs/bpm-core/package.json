{
  "name": "@rytass/bpm-core-nestjs-module",
  "version": "0.11.0",
  "description": "Embeddable NestJS BPM approval workflow module: workflow engine, approval templates, forms, organization/member contracts, attachments, signatures, notifications, delegation, and TypeORM migrations.",
  "keywords": [
    "bpm",
    "approval",
    "workflow",
    "nestjs",
    "graphql",
    "typeorm",
    "postgres",
    "form-builder",
    "rytass"
  ],
  "homepage": "https://github.com/Rytass/BPMCore#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rytass/BPMCore.git",
    "directory": "libs/bpm-core"
  },
  "bugs": {
    "url": "https://github.com/Rytass/BPMCore/issues"
  },
  "author": "Rytass <hello@rytass.com>",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "commonjs",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "typesVersions": {
    "*": {
      "attachment": [
        "./src/lib/attachment/index.d.ts"
      ],
      "bpm-auth": [
        "./src/lib/bpm-auth/index.d.ts"
      ],
      "calendar": [
        "./src/lib/calendar/index.d.ts"
      ],
      "condition": [
        "./src/lib/condition/index.d.ts"
      ],
      "database": [
        "./src/lib/database/index.d.ts"
      ],
      "delegation": [
        "./src/lib/delegation/index.d.ts"
      ],
      "form": [
        "./src/lib/form/index.d.ts"
      ],
      "form-data-source": [
        "./src/lib/form-data-source/index.d.ts"
      ],
      "identity": [
        "./src/lib/identity/index.d.ts"
      ],
      "migrations": [
        "./src/lib/migrations/index.d.ts"
      ],
      "notification": [
        "./src/lib/notification/index.d.ts"
      ],
      "organization": [
        "./src/lib/organization/index.d.ts"
      ],
      "signature": [
        "./src/lib/signature/index.d.ts"
      ],
      "template": [
        "./src/lib/template/index.d.ts"
      ],
      "workflow-engine": [
        "./src/lib/workflow-engine/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json",
    "./attachment": {
      "types": "./src/lib/attachment/index.d.ts",
      "default": "./src/lib/attachment/index.js"
    },
    "./bpm-auth": {
      "types": "./src/lib/bpm-auth/index.d.ts",
      "default": "./src/lib/bpm-auth/index.js"
    },
    "./calendar": {
      "types": "./src/lib/calendar/index.d.ts",
      "default": "./src/lib/calendar/index.js"
    },
    "./database": {
      "types": "./src/lib/database/index.d.ts",
      "default": "./src/lib/database/index.js"
    },
    "./condition": {
      "types": "./src/lib/condition/index.d.ts",
      "default": "./src/lib/condition/index.js"
    },
    "./delegation": {
      "types": "./src/lib/delegation/index.d.ts",
      "default": "./src/lib/delegation/index.js"
    },
    "./form": {
      "types": "./src/lib/form/index.d.ts",
      "default": "./src/lib/form/index.js"
    },
    "./form-data-source": {
      "types": "./src/lib/form-data-source/index.d.ts",
      "default": "./src/lib/form-data-source/index.js"
    },
    "./identity": {
      "types": "./src/lib/identity/index.d.ts",
      "default": "./src/lib/identity/index.js"
    },
    "./migrations": {
      "types": "./src/lib/migrations/index.d.ts",
      "default": "./src/lib/migrations/index.js"
    },
    "./notification": {
      "types": "./src/lib/notification/index.d.ts",
      "default": "./src/lib/notification/index.js"
    },
    "./organization": {
      "types": "./src/lib/organization/index.d.ts",
      "default": "./src/lib/organization/index.js"
    },
    "./signature": {
      "types": "./src/lib/signature/index.d.ts",
      "default": "./src/lib/signature/index.js"
    },
    "./template": {
      "types": "./src/lib/template/index.d.ts",
      "default": "./src/lib/template/index.js"
    },
    "./workflow-engine": {
      "types": "./src/lib/workflow-engine/index.d.ts",
      "default": "./src/lib/workflow-engine/index.js"
    }
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "@nestjs/graphql": ">=12.0.0",
    "@nestjs/typeorm": ">=10.0.0",
    "@rytass/bpm-core-shared": "^0.11.0",
    "@rytass/secret-adapter-vault-nestjs": ">=0.4.5",
    "express": ">=4.0.0",
    "graphql": ">=16.0.0",
    "reflect-metadata": ">=0.1.13",
    "typeorm": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "@rytass/secret-adapter-vault-nestjs": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
