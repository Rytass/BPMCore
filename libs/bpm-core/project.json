{
  "name": "bpm-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/bpm-core/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/bpm-core",
        "main": "libs/bpm-core/src/index.ts",
        "tsConfig": "libs/bpm-core/tsconfig.lib.json",
        "generatePackageJson": true,
        "assets": [
          "libs/bpm-core/*.md",
          {
            "input": ".",
            "glob": "LICENSE",
            "output": "."
          }
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/libs/bpm-core"
      ],
      "options": {
        "jestConfig": "libs/bpm-core/jest.config.cts",
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/bpm-core/tsconfig.lib.json"
      }
    },
    "pkg-quality": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "commands": [
          "pnpm exec publint dist/libs/bpm-core"
        ],
        "parallel": false
      }
    },
    "pkg-quality-attw": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "pnpm exec attw --pack dist/libs/bpm-core"
      }
    },
    "prepublish-check": {
      "executor": "nx:noop",
      "dependsOn": [
        "typecheck",
        "lint",
        "test",
        "build",
        "pkg-quality"
      ]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/libs/bpm-core"
      }
    }
  }
}
