{
  "name": "bpm-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/bpm-core/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/bpm-core",
        "main": "libs/bpm-core/src/index.ts",
        "tsConfig": "libs/bpm-core/tsconfig.lib.json",
        "generatePackageJson": true,
        "assets": [
          "libs/bpm-core/*.md",
          {
            "input": ".",
            "glob": "LICENSE",
            "output": "."
          }
        ]
      }
    },
    "test": {
      "dependsOn": [
        "test-real-engine"
      ],
      "options": {
        "passWithNoTests": true
      }
    },
    "test-real-engine": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/.env.test",
        {
          "externalDependencies": [
            "jest",
            "ts-jest",
            "cel-js",
            "@marcbachmann/cel-js"
          ]
        }
      ],
      "outputs": [],
      "cache": true,
      "options": {
        "command": "jest --config libs/bpm-core/jest.real-engine.config.cts --maxWorkers=2",
        "envFile": ".env.test",
        "env": {
          "TS_NODE_COMPILER_OPTIONS": "{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/bpm-core/tsconfig.lib.json"
      }
    },
    "pkg-quality": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "commands": [
          "pnpm exec publint dist/libs/bpm-core"
        ],
        "parallel": false
      }
    },
    "pkg-quality-attw": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "pnpm exec attw --pack dist/libs/bpm-core"
      }
    },
    "prepublish-check": {
      "executor": "nx:noop",
      "dependsOn": [
        "typecheck",
        "lint",
        "test",
        "build",
        "pkg-quality"
      ]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/libs/bpm-core"
      }
    }
  }
}
