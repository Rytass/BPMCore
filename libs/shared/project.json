{
  "name": "shared",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/shared",
        "main": "libs/shared/src/index.ts",
        "tsConfig": "libs/shared/tsconfig.lib.json",
        "assets": [
          "libs/shared/*.md",
          {
            "input": ".",
            "glob": "LICENSE",
            "output": "."
          }
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/shared/tsconfig.lib.json"
      }
    },
    "finalize-dist": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/libs/shared"
      ],
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node tools/publish/finalize-dist-package.mjs dist/libs/shared"
      }
    },
    "pkg-quality": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "finalize-dist"
      ],
      "options": {
        "commands": [
          "pnpm exec publint dist/libs/shared"
        ],
        "parallel": false
      }
    },
    "pkg-quality-attw": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "pnpm exec attw --pack dist/libs/shared"
      }
    },
    "prepublish-check": {
      "executor": "nx:noop",
      "dependsOn": [
        "typecheck",
        "lint",
        "build",
        "pkg-quality"
      ]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/libs/shared"
      }
    }
  }
}
